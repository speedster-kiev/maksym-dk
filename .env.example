# Scaleway API & LLM
LLM_BASE_URL=https://api.scaleway.ai/v1
LLM_API_KEY=
CHAT_MODEL=gemma-4-26b-a4b-it
EXPORT_MODEL=gemma-4-26b-a4b-it

# Chat function config
PROFILE_URL=https://maksym.dk/data/profile.json
ALLOWED_ORIGINS=https://maksym.dk,https://www.maksym.dk
CHAT_ENABLED=true
PUBLIC_EMAIL=

# Object Storage (S3-compatible)
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_ACCESS_KEY=
S3_SECRET_KEY=
SITE_BUCKET=maksym-dk-site
LOG_BUCKET=maksym-dk-private

# log-reader app (npm run logs), read-only on the private project
LOG_S3_ACCESS_KEY=
LOG_S3_SECRET_KEY=

# Publish tool
SOURCE_DIR=/path/to/source/markdown/files
SOURCE_IGNORE=node_modules/**,.*
BACKSTOP_BLOCK_WORDS=
BACKSTOP_WARN_WORDS=
